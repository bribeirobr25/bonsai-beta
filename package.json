{
  "name": "bar-bonsai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run --config vitest.rls.config.ts",
    "check:service-role": "node scripts/check-service-role.mjs",
    "check:data-egress": "node scripts/check-data-egress.mjs",
    "check:scheduled-jobs": "node scripts/check-scheduled-jobs.mjs",
    "check:copy-claims": "node scripts/check-copy-claims.mjs",
    "check:analytics": "node scripts/check-analytics-contract.mjs",
    "check:environments": "node scripts/check-environments.mjs",
    "check:privacy-claims": "node scripts/check-privacy-claims.mjs",
    "check:testability": "node scripts/check-testability.mjs",
    "check:adrs": "node scripts/check-adrs.mjs",
    "check:gates": "pnpm check:service-role && pnpm check:data-egress && pnpm check:scheduled-jobs && pnpm check:copy-claims && pnpm check:privacy-claims && pnpm check:analytics && pnpm check:environments && pnpm check:testability && pnpm check:adrs",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "drizzle-orm": "^0.45.2",
    "exifr": "^7.1.3",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp"
    ]
  }
}
