# Copy to .env.local. Values below are the local Supabase defaults printed by
# `pnpm supabase start` (`pnpm supabase status` shows them again).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (formerly "anon key") and secret key (formerly "service_role").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Any random string ≥16 chars. Never rotate after launch (breaks pseudonyms).
EVENTS_PEPPER=change-me-to-a-long-random-string
# Optional locally; required on Vercel (the cron sends it as a bearer token).
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
