# Copy to .env.local. Values below are the local Supabase defaults printed by
# `pnpm supabase start` (`pnpm supabase status` shows them again).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (formerly "anon key") and secret key (formerly "service_role").
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Any random string ≥16 chars. Never rotate after launch (breaks pseudonyms).
EVENTS_PEPPER=change-me-to-a-long-random-string
# Optional locally; required on Vercel (the cron sends it as a bearer token).
CRON_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Analytics and telemetry -------------------------------------------------
# Which generation of EVENTS_PEPPER is in use. Stamped on every event so an
# emergency secret rotation is visible in the data instead of inferred from a
# deploy log. Bump it in the SAME deploy as the secret. Plan §24.7.
EVENTS_PSEUDONYM_VERSION=1

# Default session classification for this deployment (OI-50, plan §24.8).
# Set INTERNAL on Staging so its traffic can never be mistaken for evidence.
# Leave as USER in production: an unclassified event must count as evidence
# rather than be silently excluded.
SESSION_CLASS_DEFAULT=USER

# Gate TEL-1 / OI-02. Tier-1 legitimate-interest telemetry ships INERT and
# activation is LEGAL PENDING (blocker B-12). Setting this to "true" is NOT
# sufficient on its own: collection also requires a recorded legal approval at
# docs/07-legal/TELEMETRY-LEGAL-APPROVAL.md. Do not flip this without one.
TELEMETRY_LEGITIMATE_INTEREST_ENABLED=false
